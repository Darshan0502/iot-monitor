# Port for the HTTP API
PORT=4000

# PostgreSQL from docker-compose.yml (exposed on host port 5433).
# connect_timeout gives Docker on a busy machine time to accept the first connection.
DATABASE_URL=postgresql://iot:iot@localhost:5433/iot_monitor?schema=public&connect_timeout=15

# Mosquitto from docker-compose.yml
MQTT_URL=mqtt://localhost:1883

# A device that has sent readings before but sends none for this many seconds gets an OFFLINE alert
OFFLINE_AFTER_SECONDS=60
