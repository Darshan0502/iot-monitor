generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A physical sensor that sends readings over MQTT.
model Device {
  id         String    @id @default(uuid()) @db.Uuid
  /// Unique code the device puts in its MQTT topic, for example "sensor-01".
  serial     String    @unique
  name       String
  location   String?
  /// Last time a reading arrived from this device.
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)

  /// Alert limits: a reading outside them opens an alert. Null means no limit on that side.
  temperatureMin Float? @map("temperature_min")
  temperatureMax Float? @map("temperature_max")
  humidityMin    Float? @map("humidity_min")
  humidityMax    Float? @map("humidity_max")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  readings  Reading[]
  alerts    Alert[]

  @@map("devices")
}

/// One measurement a device sent over MQTT.
model Reading {
  id          BigInt   @id @default(autoincrement())
  deviceId    String   @map("device_id") @db.Uuid
  temperature Float?
  humidity    Float?
  /// When the device took the measurement (its own timestamp, or the arrival time if it sent none).
  recordedAt  DateTime @map("recorded_at") @db.Timestamptz(3)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Every read is "the latest readings of one device", so this index serves them all.
  @@index([deviceId, recordedAt(sort: Desc)])
  @@map("readings")
}

enum AlertType {
  TEMPERATURE_HIGH
  TEMPERATURE_LOW
  HUMIDITY_HIGH
  HUMIDITY_LOW
  OFFLINE

  @@map("alert_type")
}

/// A problem with a device. It stays open (resolvedAt is null) until the device is back to normal.
model Alert {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @map("device_id") @db.Uuid
  type       AlertType
  /// The reading that opened the alert and the limit it crossed. Both are null for OFFLINE alerts.
  value      Float?
  threshold  Float?
  message    String
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // For "the open alerts of this device", which every reading looks up.
  @@index([deviceId, resolvedAt])
  // For the alert list, newest first.
  @@index([startedAt(sort: Desc)])
  @@map("alerts")
}
